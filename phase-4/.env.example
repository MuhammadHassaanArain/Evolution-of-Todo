# =============================================================================
# Docker Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file with real credentials to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string for Neon Serverless Database
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens (use a strong random string in production)
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# External API key for AI model (e.g., Google Gemini)
API_KEY=your-api-key-here
MODEL_NAME=gemini-2.5-flash

# API prefix for backend routes
API_PREFIX=/api

# CORS allowed origins (use specific domains in production)
ALLOWED_ORIGINS=*

# Database echo mode (set to False in production)
DB_ECHO=False

# -----------------------------------------------------------------------------
# Service URLs (Docker Compose Configuration)
# -----------------------------------------------------------------------------
# MCP Server URL for backend to communicate with MCP server
# Use service name 'mcp-server' for container-to-container communication
MCP_SERVER_URL=http://mcp-server:8001/mcp/

# Backend API URL for MCP server to communicate with backend
# Use service name 'backend' for container-to-container communication
BACKEND_API_URL=http://backend:8000

# Frontend API URLs for browser requests
# Use 'localhost' for browser-to-backend communication (not service names)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# MCP Server Configuration
# -----------------------------------------------------------------------------
# Port and host for MCP server
MCP_SERVER_PORT=8001
MCP_SERVER_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - Service names (backend, mcp-server) are used for inter-container communication
# - localhost is used for browser-to-backend communication
# - All services run on the same Docker network (todo-network)
# - Port mappings: frontend:3000, backend:8000, mcp-server:8001
# =============================================================================
